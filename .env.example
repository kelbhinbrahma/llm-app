# Copy this file to .env and fill in the values:   cp .env.example .env
# Never commit the real .env file (it is in .gitignore).

# --- Security ---
# Make a random secret with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=60

# Passwords for the 3 demo users (admin / alice / viewer)
ADMIN_PASSWORD=admin123
USER_PASSWORD=alice123
READONLY_PASSWORD=viewer123

# --- LLM ---
# "mock" works without any key. Use "gemini" + a free key from https://aistudio.google.com/apikey
LLM_PROVIDER=mock
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_FALLBACK_MODEL=gemini-2.5-flash-lite
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2

# --- Redis ---
CACHE_TTL_SECONDS=3600
RATE_LIMIT_PER_MINUTE=10

# --- PostgreSQL (used by docker-compose) ---
POSTGRES_USER=qa_user
POSTGRES_PASSWORD=qa_password
POSTGRES_DB=qa_db

# For running the app WITHOUT Docker you can set these
# (inside Docker, docker-compose.yml sets them for you):
# DATABASE_URL=sqlite:///./local.db
# REDIS_URL=redis://localhost:6379/0
